# === HYPERSPACE DB CONFIGURATION ===

# --- Security ---
HYPERSPACE_API_KEY=I_LOVE_HYPERSPACEDB
# TLS/mTLS configuration (leave empty or set to "off" to disable)
# Path to the TLS certificate file (PEM format) for gRPC and HTTP
HS_TLS_CERT=off
# Path to the TLS private key file (PEM format) for gRPC and HTTP
HS_TLS_KEY=off
# Path to the client CA certificate file (PEM format) to enable client certification verification (mTLS)
HS_TLS_CA=off

# --- Audit Logging ---
# Audit logging level: off, low (DDL/Admin), medium (DDL + Writes), high (Medium + Reads), full (Everything)
HS_AUDIT_LOG_LEVEL=off
# Audit log output destination: stdout, file
HS_AUDIT_LOG_DEST=stdout
# Audit log file path (if destination is file)
HS_AUDIT_LOG_PATH=audit.log

# --- Server Dimensions & Metric ---
# Use 'poincare', 'l2', 'cosine', 'lorentz' and 'hybrid' as metric
HS_DIMENSION=1024
HS_METRIC=cosine

# Option 2: Scientific / Native Hyperbolic
# Use 'lorentz' for maximum efficiency on compressed hyperbolic vectors.
# HS_DIMENSION=65
# HS_METRIC=lorentz

# --- HNSW Engine Tuning ---
HS_HNSW_M=64
HS_HNSW_EF_CONSTRUCT=400
HS_HNSW_EF_SEARCH=400
# If filtered candidate set is small, bypass HNSW layer-0 traversal and run exact brute-force over allowed bitmap.
HS_FILTER_BRUTEFORCE_THRESHOLD=50000

# --- Durability & Safety ---
# Options: async (default), batch (100ms lag), strict (fsync every write)
# Controls the trade-off between write speed and data safety.
HYPERSPACE_WAL_SYNC_MODE=batch
# Interval for Batch mode in milliseconds
HYPERSPACE_WAL_BATCH_INTERVAL=100
# WAL segment size in MB. When the active WAL reaches this size, it is frozen
# and a background worker builds a new immutable chunk (chunk_*.hyp).
# Larger = fewer flushes, lower CPU overhead on RAM-rich servers.
# Smaller = more frequent rotations, better for RAM-constrained / S3-tiered deployments.
# Range: 16..4096 MB. Default: 512 MB (optimized for performance).
HS_WAL_SEGMENT_SIZE_MB=512

# --- Performance & Resource Management ---
# Storage Mode: performance (default, server) or tiered (LSM-style, edge)
# performance: All data in RAM, snapshots for persistence. Maximum performance.
# tiered: Flushes to disk chunks when MemTable exceeds memory budget. For edge devices.
HS_MODE=performance
# Max RAM budget for the in-memory index in GB.
# If not set, defaults to 70% of total system RAM.
# HS_MAX_RAM_GB=44
# Idle collection timeout in seconds. Collections that are not accessed for this long
# are automatically unloaded (frozen) from RAM to free up memory (Lazy Loading).
# Default: 3600 seconds (1 hour)
HS_IDLE_TIMEOUT_SEC=3600

# Number of parallel threads for HNSW graph construction
# 1 = Serial (best quality/recall, slower indexing)
# 0 = Auto (uses all CPU cores, faster but lower recall due to race conditions)
# Recommended: 1 for production, 0 for bulk imports where recall can be sacrificed
HS_INDEXER_CONCURRENCY=0

# --- Storage & Quantization ---
# Quantization compression level. Choose between performance (precision) and RAM savings.
#
#   none    — No compression. Full f64 precision. Highest RAM usage, best accuracy.
#             Use when: unbounded L2 vectors with magnitude > 1, maximum recall needed.
#
#   medium  — Balanced. ScalarI8 (8-bit) for L2 / Cosine / Poincaré / Lorentz collections.
#             For Hybrid metric (dim=801): automatically uses AsymmetricHybrid801 instead —
#             which preserves Lorentz time-axis (dims 0..33) as f32 and compresses the
#             remaining 768 Euclidean dimensions as i8. Prevents recall loss on hyperbolic data.
#             RAM savings: ~8× vs none. Recommended for most production deployments.
#             (Legacy aliases: "scalar", "asymmetric_hybrid_801")
#
#   extreme — Binary (1-bit per dimension). Maximum compression (~64× vs none).
#             Only supported for L2 and Cosine metrics. Use for ultra-high-throughput
#             approximate search where some recall loss is acceptable.
#             WARNING: Not supported for Poincaré, Lorentz, Hybrid (will use ScalarI8 fallback).
#             (Legacy alias: "binary")
#
# Note: Scalar quantization clamps values to [-1, 1]. Use 'none' for unbounded L2 vectors.
HS_QUANTIZATION_LEVEL=medium
# Enable ScaNN-style anisotropic refinement for 8-bit quantization.
# Improves recall and ranking quality (especially for Cosine/L2) but adds CPU overhead during indexing.
# Set to 'false' for maximum raw ingestion speed.
HS_ANISOTROPIC_REFINEMENT=false
# Store raw (mode=none) vectors as f32 in mmap, then promote to f64 in distance kernel. Saves ~50% RAM for raw vectors.
HS_STORAGE_FLOAT32=true
# Fast-upsert threshold: if vector shift L2 <= delta and metadata unchanged, skip graph relinking.
# 0.0 disables fast-upsert (always relink graph).
# Typical values: 0.001..0.05 for small continuous updates; >0.1 may preserve stale neighborhood links.
HS_FAST_UPSERT_DELTA=0.0
# ID Mapping bypass: set to 'true' if user IDs always match internal IDs (no upserts).
# Skips DashMap lookups on insert/search, reducing latency by ~10%.
# WARNING: Only enable if you never upsert (update) existing vectors.
HS_IDENTITY_IDS=false
# Broadcast ring size for CDC/replication event stream.
HS_EVENT_STREAM_BUFFER=1024
# Enable exact top-K re-rank after ANN candidate fetch.
HS_RERANK_ENABLED=true
# Oversample factor for ANN candidates before exact re-rank.
HS_RERANK_OVERSAMPLE=4
# Enable runtime auto-dispatch policy for batch metric kernels.
HS_GPU_BATCH_ENABLED=false
# Conservative offload thresholds to avoid GPU regression on tiny rerank batches.
HS_GPU_MIN_BATCH=192
HS_GPU_MIN_DIM=1024
HS_GPU_MIN_WORK=393216
# Per-metric GPU dispatch toggles (effective only when HS_GPU_BATCH_ENABLED=true and build uses --features gpu-runtime).
HS_GPU_L2_ENABLED=true
HS_GPU_COSINE_ENABLED=true
HS_GPU_POINCARE_ENABLED=true
HS_GPU_LORENTZ_ENABLED=true

# --- Server-Side Wave Search Config (Klein-Gordon Diffusion) ---
# Optional: Enable server-side Klein-Gordon wave diffusion for all use_wave=true requests.
# When disabled (false), the server returns FAILED_PRECONDITION, and the Python client
# automatically falls back to client-side multi-seed consensus wave search.
# Toggling this to false lets standard HNSW ANN searches run at full 1500-2000 QPS.
HS_SERVER_WAVE_SEARCH_ENABLED=true

# Depth/number of diffusion iterations (graph hops).
# Higher = deeper graph traversal, more multi-hop discovery, slower per query.
# Recommended: 2-4 for structural queries (legal/financial), 1-2 for factual retrieval.
HS_SERVER_WAVE_DEPTH=3

# Wave energy damping/decay per step (0 < damping ≤ 1).
# Controls how fast energy dissipates as it propagates further from seeds.
# Lower = faster decay (stays local), Higher = wider propagation.
# Recommended: 0.8-0.9
HS_SERVER_WAVE_DAMPING=0.85

# Gaussian kernel bandwidth σ for edge transfer weights: exp(-d²/σ²).
# Controls how far energy can jump across distant edges.
# Higher σ = energy flows over longer edges (wider but noisier diffusion).
# Recommended: 0.5-1.5 depending on your vector space scale.
HS_SERVER_WAVE_SIGMA=1.0

# Klein-Gordon mass term m² for bandpass filtering.
# At each step, nodes lose m²×ψ energy (penalises low-energy / noise nodes).
# m²=0 → pure diffusion (no filtering); m²=0.2 → aggressive bandpass.
# Higher values make the wave more selective but may miss distant clusters.
# Recommended: 0.05-0.2
HS_SERVER_WAVE_MASS_SQ=0.1

# Maximum active frontier nodes per diffusion step (beam pruning).
# Prevents exponential node explosion on dense HNSW graphs.
# Lower = faster but may miss some clusters; Higher = better recall, more RAM.
# Recommended: 100-500
HS_SERVER_WAVE_BEAM_WIDTH=200

# Query-potential field strength λ (Schrödinger-like correction).
# At each step, seed nodes receive a λ×V(x)×ψ energy boost,
# re-attracting the wave front toward query-relevant space.
# λ=0 → disabled; λ=1.0 → strong correction (may overfit to seeds).
# Recommended: 0.3-0.7
HS_SERVER_WAVE_QUERY_POTENTIAL=0.5

# Schrödinger query-potential driving strength (restart factor α, 0.0 ≤ α ≤ 1.0).
# Inject a continuous energy stream proportional to query similarity back to seeds.
# Keeps the wave anchored to the original semantic query, preventing popularity/hubness drift.
# α=0.0 → free diffusion; α=1.0 → pure semantic search (no graph diffusion).
# Recommended: 0.20 - 0.35
HS_SERVER_WAVE_RESTART_FACTOR=0.60

# Internal fan-out for SearchBatch handler (1 = deterministic/serial, >1 = bounded parallel).
HS_SEARCH_BATCH_INNER_CONCURRENCY=32
# Global limit for concurrent search tasks in collection worker pool.
# 0 = auto (CPU count * 2), recommended range: CPU..(CPU*4) depending on latency SLA.
# Auto mode provides optimal throughput: 2x cores for parallelism, capped at 4x to avoid thrashing.
HS_SEARCH_CONCURRENCY=256

# --- Graph Optimization (Compaction) ---
# Automatic graph rebuild interval in hours (0 = disabled)
# Rebuilds the HNSW graph sequentially for maximum quality
# Recommended: 24-48 hours for production systems with high write load
# Set to 0 to disable automatic optimization
HS_OPTIMIZE_INTERVAL_HOURS=0

# --- Replication & Data Streaming ---
# Set to 'false' to disable outgoing replication gRPC streams.
# When disabled, followers will be denied access to the stream even with a valid API key.
# Recommended: 'true' for high-availability clusters, 'false' for standalone secure nodes.
HS_REPLICATION_ALLOWED=false

# === EMBEDDING PIPELINE CONFIGURATION ===
# Provide vectors automatically (InsertText / SearchText RPC).
# Embedding is DISABLED by default — set to 'true' to enable.
HYPERSPACE_EMBED=false

# ─────────────────────────────────────────────────────────────────────────────
# Per-Metric Embedding Architecture
# ─────────────────────────────────────────────────────────────────────────────
# HyperspaceDB supports 4 geometry types: l2, cosine, poincare, lorentz
# Each geometry can have its own embedding backend independently:
#
#   HS_EMBED_<METRIC>_PROVIDER — one of:
#     local        → local ONNX file (fastest, no network)
#     huggingface  → download model.onnx + tokenizer.json from HF Hub
#     openai       → OpenAI Embeddings API
#     cohere       → Cohere Embed API
#     mistral      → Mistral Embeddings API
#     voyage       → Voyage AI API
#     openrouter   → OpenRouter API
#     generic      → Any OpenAI-compatible API (set HS_EMBED_<METRIC>_API_BASE)
#     disabled     → No embedding for this metric (default)
#
# If HS_EMBED_<METRIC>_PROVIDER is not set, falls back to HYPERSPACE_EMBED_PROVIDER.
# ─────────────────────────────────────────────────────────────────────────────

# --- Global Embedding Fallback ---
# Used if no per-metric provider is configured.
# HYPERSPACE_EMBED_PROVIDER=disabled

# --- Hugging Face Token (applies to ALL huggingface providers) ---
# Required for gated/private models, optional for public ones.
# Can also be set via env: HUGGING_FACE_HUB_TOKEN (same effect)
# HF_TOKEN=hf_your_token_here

# ─────────────────────────────────────────────────────────────────────────────
# L2 (Euclidean) Geometry Embedding
# ─────────────────────────────────────────────────────────────────────────────
# HS_EMBED_L2_PROVIDER=disabled

# Option A: Local ONNX
# HS_EMBED_L2_MODEL_PATH=./models/bge-small-en-v1.5.onnx
# HS_EMBED_L2_TOKENIZER_PATH=./models/bge-small-en-v1.5-tokenizer.json
# HS_EMBED_L2_DIM=384

# Option B: HuggingFace Hub (auto-downloads model.onnx + tokenizer.json)
# HS_EMBED_L2_PROVIDER=huggingface
# HS_EMBED_L2_HF_MODEL_ID=BAAI/bge-small-en-v1.5
# HS_EMBED_L2_DIM=384

# Option C: Remote API
# HS_EMBED_L2_PROVIDER=openai
# HS_EMBED_L2_EMBED_MODEL=text-embedding-3-small
# HS_EMBED_L2_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# NEW: Qwen3-Embedding-0.6B (Supports L2 & Cosine)
# Context: 32K tokens | Max Dimension: 1024d
# https://huggingface.co/Qwen/Qwen3-Embedding-0.6B
# ─────────────────────────────────────────────────────────────────────────────
# L2 Configuration
HS_EMBED_L2_PROVIDER=huggingface
HS_EMBED_L2_HF_MODEL_ID=onnx-community/Qwen3-Embedding-0.6B-ONNX
HS_EMBED_L2_HF_FILENAME=onnx/model.onnx
HS_EMBED_L2_DIM=1024
# Chunking for 32K context (use smaller chunks for efficiency)
HS_EMBED_L2_CHUNK_SIZE=4096
HS_EMBED_L2_OVERLAP=0.10  # 10% overlap between chunks

# ─────────────────────────────────────────────────────────────────────────────
# Cosine Geometry Embedding
# ─────────────────────────────────────────────────────────────────────────────
# See Qwen3-Embedding-0.6B configuration above (HS_EMBED_COSINE_*)
#
# Alternative configurations (commented out):
# ─────────────────────────────────────────────────────────────────────────────
# HS_EMBED_COSINE_PROVIDER=disabled

# Option A: Local ONNX
# HS_EMBED_COSINE_MODEL_PATH=./models/e5-large-v2.onnx
# HS_EMBED_COSINE_TOKENIZER_PATH=./models/e5-large-v2-tokenizer.json
# HS_EMBED_COSINE_DIM=1024

# Cosine Configuration (same model, different normalization)
HS_EMBED_COSINE_PROVIDER=huggingface
HS_EMBED_COSINE_HF_MODEL_ID=onnx-community/Qwen3-Embedding-0.6B-ONNX
HS_EMBED_COSINE_HF_FILENAME=onnx/model.onnx
HS_EMBED_COSINE_DIM=1024
HS_EMBED_COSINE_CHUNK_SIZE=4096
HS_EMBED_COSINE_OVERLAP=0.10  # 10% overlap between chunks

# Option C: Remote API
# HS_EMBED_COSINE_PROVIDER=openai
# HS_EMBED_COSINE_EMBED_MODEL=text-embedding-3-large
# HS_EMBED_COSINE_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# Poincaré Geometry Embedding
# Best for hierarchical / tree-like data (ontologies, taxonomies, KB graphs)
# Vectors must lie inside the unit ball: ||x|| < 1
# ─────────────────────────────────────────────────────────────────────────────
# HS_EMBED_POINCARE_PROVIDER=disabled

# Option A: Local ONNX (recommended — hyperbolic models are rare on hosted APIs)
# HS_EMBED_POINCARE_MODEL_PATH=./models/poincare_128d.onnx
# HS_EMBED_POINCARE_TOKENIZER_PATH=./models/poincare_128d_tokenizer.json
# HS_EMBED_POINCARE_DIM=128

# Option B: HuggingFace Hub (CDE-Spatial or custom hyperbolic model)
# NEW: YARlabs v5_Embedding_0.5B with chunking support (512 tokens context)
HS_EMBED_POINCARE_PROVIDER=huggingface
HS_EMBED_POINCARE_HF_MODEL_ID=YARlabs/v5_Embedding_0.5B
HS_EMBED_POINCARE_HF_FILENAME=v5_Embedding.onnx
HS_EMBED_POINCARE_DIM=128
# Chunking configuration for 512 token context window
HS_EMBED_POINCARE_CHUNK_SIZE=512
HS_EMBED_POINCARE_OVERLAP=0.15  # 15% overlap between chunks

# Option C: Remote API (generic OpenAI-compatible endpoint serving hyperbolic embeddings)
# HS_EMBED_POINCARE_PROVIDER=generic
# HS_EMBED_POINCARE_API_BASE=http://localhost:8080/v1/embeddings
# HS_EMBED_POINCARE_API_KEY=local-key

# ─────────────────────────────────────────────────────────────────────────────
# Lorentz Geometry Embedding
# Best for mixed hierarchical + semantic data (knowledge graphs, multimodal)
# Vectors lie on the Lorentz hyperboloid: -x₀² + x₁²+...+xₙ² = -1
# ─────────────────────────────────────────────────────────────────────────────
# HS_EMBED_LORENTZ_PROVIDER=disabled

# Option A: Local ONNX
# HS_EMBED_LORENTZ_MODEL_PATH=./models/lorentz_128d.onnx
# HS_EMBED_LORENTZ_TOKENIZER_PATH=./models/lorentz_128d_tokenizer.json
# HS_EMBED_LORENTZ_DIM=129   # Note: Lorentz dim = Euclidean_dim + 1 (time component)

# Option B: HuggingFace Hub (CDE-Spatial v1/v2 models)
# NEW: YARlabs v5_Embedding_0.5B with chunking support (512 tokens context)
HS_EMBED_LORENTZ_PROVIDER=huggingface
HS_EMBED_LORENTZ_HF_MODEL_ID=YARlabs/v5_Embedding_0.5B
HS_EMBED_LORENTZ_HF_FILENAME=v5_Embedding.onnx
HS_EMBED_LORENTZ_DIM=129   # Correct: Lorentz dim = Spatial_dim (128) + 1 (time component)
# Chunking configuration for 512 token context window
HS_EMBED_LORENTZ_CHUNK_SIZE=512
HS_EMBED_LORENTZ_OVERLAP=0.15  # 15% overlap between chunks

# Option C: Remote API
# HS_EMBED_LORENTZ_PROVIDER=generic
# HS_EMBED_LORENTZ_API_BASE=http://localhost:8080/v1/embeddings
# HS_EMBED_LORENTZ_API_KEY=local-key

# ─────────────────────────────────────────────────────────────────────────────
# Hybrid Geometry Embedding
# Combined Lorentz (hyperbolic, 33d) and classical Cosine (768d) geometries.
# Layout: first 33 dimensions are Lorentz, remaining 768 dimensions are Cosine/L2.
# ─────────────────────────────────────────────────────────────────────────────
# HS_EMBED_HYBRID_PROVIDER=disabled

# Option A: Local ONNX
# HS_EMBED_HYBRID_MODEL_PATH=./models/hybrid_801d.onnx
# HS_EMBED_HYBRID_TOKENIZER_PATH=./models/hybrid_801d_tokenizer.json
# HS_EMBED_HYBRID_DIM=801

# Option B: HuggingFace Hub (CDE-Hybrid models)
# HS_EMBED_HYBRID_PROVIDER=huggingface
# HS_EMBED_HYBRID_HF_MODEL_ID=
# HS_EMBED_HYBRID_HF_FILENAME=
# HS_EMBED_HYBRID_DIM=801
# HS_EMBED_HYBRID_CHUNK_SIZE=8192
# HS_EMBED_HYBRID_OVERLAP=0.05

# Option C: Remote API — YAR.INK CDE-service (OpenAI-compatible, 801d Hybrid Lorentz+Euclidean)
# HS_EMBED_HYBRID_PROVIDER=yarink
# HS_EMBED_HYBRID_API_BASE=https://the.yar.ink/v1/embeddings
# HS_EMBED_HYBRID_API_KEY=YOUR_YAR_INK_API_KEY
# HS_EMBED_HYBRID_EMBED_MODEL=v5_Light
# HS_EMBED_HYBRID_DIM=801
# HS_EMBED_HYBRID_CHUNK_SIZE=8192
# HS_EMBED_HYBRID_OVERLAP=0.05

# ─────────────────────────────────────────────────────────────────────────────

# Legacy / Global Config (kept for backwards compatibility)
# These are used as fallback if per-metric keys are not set.
# ─────────────────────────────────────────────────────────────────────────────
# HYPERSPACE_MODEL_PATH=./models/v5_Embedding_128d.onnx
# HYPERSPACE_TOKENIZER_PATH=./models/v5_Embedding_Tokenizer.json
# HYPERSPACE_EMBED_DIM=128
# HYPERSPACE_HF_MODEL_ID=your-org/model-id
# HYPERSPACE_EMBED_MODEL=text-embedding-3-small
# HYPERSPACE_API_BASE=http://localhost:8080/v1/embeddings
# HYPERSPACE_API_KEY_EMBED=sk-...

# --- System Tuning ---
# Jemalloc configuration for memory usage vs CPU trade-off.
# background_thread:true enables background memory reclamation.
# dirty_decay_ms:0 releases unused memory immediately (low RAM, higher CPU).
# dirty_decay_ms:10000 (default) keeps memory for reuse (high RAM, lower CPU).
MALLOC_CONF=background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:5000

# ═══════════════════════════════════════════════════════════════════════════
# S3 Tiering (OPTIONAL — requires cargo build --features s3-tiering)
# ═══════════════════════════════════════════════════════════════════════════

# Storage backend: "local" (default) or "s3"
# "local" — all chunks stay on local NVMe/SSD. Best for edge & performance.
# "s3"    — cold chunks are offloaded to S3/MinIO with local LRU cache.
HS_STORAGE_BACKEND=local

# S3 bucket for chunk storage
# HS_S3_BUCKET=hyperspace-chunks

# AWS region
# HS_S3_REGION=us-east-1

# S3-compatible endpoint (for MinIO, Ceph, LocalStack)
# HS_S3_ENDPOINT=http://localhost:9000

# AWS/MinIO credentials
# HS_S3_ACCESS_KEY=minioadmin
# HS_S3_SECRET_KEY=minioadmin

# Object key prefix inside the bucket
# HS_S3_PREFIX=v1/chunks

# Local LRU cache size limit in GB (S3 mode only)
# When exceeded, oldest chunks are evicted to S3 and removed from disk.
# HS_MAX_LOCAL_CACHE_GB=10

# Max retry attempts for transient S3 errors (network interruptions)
# Uses exponential backoff: 100ms, 200ms, 400ms, ...
# HS_S3_MAX_RETRIES=3

# Parallel S3 upload/download slots (semaphore-limited)
# HS_S3_UPLOAD_CONCURRENCY=4

# Number of chunks to probe per search query (MetaRouter)
# Higher = better recall, lower = faster search. Default: 3.
HS_CHUNK_PROBE_K=3

# ═══════════════════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════════════════

# --- Gossip & Anti-Entropy (Clustering) ---
# Set to 'true' to enable decentralized cluster discovery (UDP Heartbeats) and Merkle Tree synchronization.
# CRITICAL PERFORMANCE NOTE: When enabled, every insert/delete triggers a FNV-1a bucket hash update.
# Keep as 'false' for maximum standalone performance unless you are running a multi-node cluster.
HS_GOSSIP_ENABLED=false

# Port for the UDP Heartbeat listener (default 7946)
HS_GOSSIP_PORT=7946

# Comma-separated list of known peers to bootstrap the swarm
# Example: 192.168.1.10:7946,192.168.1.11:7946
HS_GOSSIP_PEERS=

# --- BM25 Engine Tuning ---
# BM25 Method: bm25plus, bm25l, robertson, lucene, atire (Default: bm25plus)
HS_BM25_METHOD=bm25plus
# Term saturation parameter (Default: 1.2)
HS_BM25_K1=1.2
# Document length normalization parameter (Default: 0.75)
HS_BM25_B=0.75
# Additive smoothing for BM25+ / BM25L (Default: 0.5)
HS_BM25_DELTA=0.5
# Tokenizer language (english, russian, french, etc. Default: english)
HS_BM25_LANGUAGE=english
# Enable N-Grams? (1 = unigrams, 2 = unigrams+bigrams. Default: 1)
HS_BM25_NGRAMS=1

# --- Search Fusion Tuning ---
# Fusion method for hybrid search: rrf (default) or weighted
HS_FUSION_METHOD=rrf

# ═══════════════════════════════════════════════════════════════════════════
# L0 HOT TIER CACHE (in-memory vector cache for ultra-low latency reads)
# ═══════════════════════════════════════════════════════════════════════════
#
# The cache is a two-level structure layered in front of the HNSW index:
#
#   L1 (Exact)  — DashMap<u32, CacheEntry>
#                 Exact lookup by vector ID. Latency: ~1 µs. Always checked first.
#
#   L2 (ANN)    — HNSW graph built from the L1 hot set (instant-distance)
#                 Approximate nearest-neighbor search over cached vectors.
#                 Latency: ~100 µs. Used when no exact ID is known.
#                 Requires HYPERSPACE_CACHE_ANN_THRESHOLD to be set.
#
# Cache hit flow:
#   Request → L1 exact? YES → ~1 µs response (skip HNSW on disk)
#                         NO → L2 ANN? YES → ~100 µs response
#                                       NO  → HNSW on disk → populate cache
#
# Performance impact at dim=1024, 10 000 vectors in L1:
#   L1 hit rate ~85% → average latency drop from ~2 ms → ~0.05 ms
#   L2 hit rate ~60% (of L1 misses) → ~100 µs vs ~2 ms for disk
#   Estimated RAM per 10k vectors: ~500 MB (see HYPERSPACE_CACHE_L1_CAPACITY)
#
# --- Enable / Disable ---
# Set to 'false' to completely disable the cache layer.
# When disabled, all requests go directly to the HNSW index on disk.
# Default: true (enabled). Recommended: true for production.
HYPERSPACE_CACHE_ENABLED=true

# --- L1 Capacity ---
# Maximum number of vectors to keep in the L1 hot tier (per collection).
# When capacity is exceeded, vectors are evicted according to HYPERSPACE_CACHE_EVICTION_POLICY.
#
# RAM estimate per entry at dim=1024:
#   vector (f64)    : 1024 × 8 = 8 192 bytes
#   Arc shells      :      2 × 24 = 48 bytes
#   DashMap bucket  :             80 bytes
#   metadata avg    :            200 bytes
#   struct fields   :             48 bytes
#   ─────────────────────────────────────────
#   Total per entry : ~8 568 bytes ≈ 8.4 KB
#
# RAM @ 10 000 vectors, dim=1024  : ~84 MB
# RAM @ 50 000 vectors, dim=1024  : ~420 MB
# RAM @ 10 000 vectors, dim=128   : ~25 MB   (dim × 8 is the dominant term)
#
# Recommended: 10 000–50 000 for production. Lower on memory-constrained hosts.
# Default: 10 000
HYPERSPACE_CACHE_L1_CAPACITY=10000

# --- Eviction Policy ---
# Controls which vectors are removed when L1 capacity is exceeded.
#
#   lru  — Least Recently Used. Evicts the vector that was accessed longest ago.
#          Best for workloads where recency predicts future access. (Default)
#
#   lfu  — Least Frequently Used. Evicts the vector with fewest accesses.
#          Best for workloads with stable hot-spots (Zipf / power-law access patterns).
#
#   ttl  — Evicts vectors whose per-entry TTL has expired (set via metadata["__ttl"]).
#          Falls back to LRU for entries without a TTL.
#          Use when vectors have natural expiry (e.g., session data, time-windowed indexes).
#
# Default: lru
HYPERSPACE_CACHE_EVICTION_POLICY=lru

# --- L2 ANN Distance Threshold ---
# Maximum distance for a cached vector to be returned as an L2 ANN hit.
# The unit depends on the collection metric:
#
#   l2 / lorentz         → squared Euclidean distance  (e.g. 1.0 ≈ unit-sphere neighbourhood)
#   cosine               → 1 − cosine_similarity        (0.0 = identical, 2.0 = opposite)
#   poincare             → hyperbolic distance           (0.0 = same point)
#
# If NOT set (default): L2 ANN is DISABLED. Only L1 exact lookups are active.
# Setting a value enables the in-memory HNSW second tier.
#
# Recommended starting values:
#   Cosine / dim=1024    : 0.15   (cosine similarity ≥ 0.85)
#   L2 normalised        : 0.05   (very tight neighbourhood)
#   Lorentz / dim=64     : 2.0
#   Poincaré / dim=128   : 0.5
#
# CAUTION: Too small → most ANN queries miss the cache (no benefit).
#          Too large  → cache returns vectors too far from the query (lower precision).
# Default: not set (L2 ANN disabled)
# HYPERSPACE_CACHE_ANN_THRESHOLD=0.15

# --- L2 ANN Rebuild Batch Size ---
# Number of new vectors that accumulate in the pending queue before triggering
# a background HNSW graph rebuild for the L2 cache tier.
#
# The rebuild is also triggered by:
#   • Eager trigger : pending queue ≥ 2 (every 100 ms background tick)
#   • Periodic check: every 5 seconds if any pending or tombstone ratio > 30%
#   • Tombstone spike: immediately if deleted vectors exceed 30% of graph size
#
# A 5-second cooldown (hard-coded) prevents rebuild storms under high write load.
# Higher values → fewer rebuilds, slightly staler L2 graph.
# Lower values  → more frequent rebuilds, fresher graph, higher CPU during writes.
#
# Recommended: 50–200. Lower for real-time search, higher for batch import workflows.
# Default: 100
HYPERSPACE_CACHE_REBUILD_BATCH=100

# ── Per-Entry TTL (via metadata) ───────────────────────────────────────────
# Vectors can be given an individual TTL (time-to-live) in seconds by adding
# a "__ttl" key to their metadata at insert time:
#
#   insert(id=42, vector=[...], metadata={"__ttl": "300"})  # expires in 5 minutes
#
# TTL expiry is checked every 100 ms by the background task.
# Expired vectors are evicted from L1 and tombstoned in L2 automatically.
# No configuration key needed — this is per-request behaviour.
# ───────────────────────────────────────────────────────────────────────────

# ── Cache HTTP Management API ───────────────────────────────────────────────
# Three HTTP endpoints are available per collection (requires Bearer token):
#
#   GET  /api/collections/{name}/cache/stats
#        Returns JSON with current cache state:
#        { "l1_size", "l2_index_size", "l1_hit_rate", "l2_hit_rate",
#          "tombstone_count", "pending_rebuild", "estimated_memory_bytes" }
#
#   POST /api/collections/{name}/cache/clear
#        Immediately flushes all cached vectors (L1 + L2). Useful after bulk deletes.
#
#   POST /api/collections/{name}/cache/config
#        Hot-reconfigures eviction policy and ANN threshold without restart.
#        Body: { "policy": "lfu", "ann_threshold": 0.15 }
# ───────────────────────────────────────────────────────────────────────────

# ── Warmup on startup ───────────────────────────────────────────────────────
# When a collection is opened (or unfrozen), the server automatically pre-loads
# up to HYPERSPACE_CACHE_L1_CAPACITY vectors from the HNSW index into L1.
# This happens in a background thread and does not block serving requests.
#
# Supported quantization modes: None (f64/f32), ScalarI8, AsymmetricHybrid801.
# Binary mode is excluded (reconstructed coords are too lossy for ANN quality).
#
# Key-value metadata (inserted via metadata dict) is also warmed up.
# PayloadStore blobs are NOT warmed (they are always fetched on-demand).
# ───────────────────────────────────────────────────────────────────────────

# ── Prometheus Metrics exposed by the cache ────────────────────────────────
# All metrics carry a `collection` label.
#
#   hyperspace_cache_l1_hits_total          — L1 exact hit counter
#   hyperspace_cache_l1_misses_total        — L1 miss counter
#   hyperspace_cache_l2_hits_total          — L2 ANN hit counter
#   hyperspace_cache_l2_misses_total        — L2 ANN miss counter
#   hyperspace_cache_inserts_total          — cache insert counter
#   hyperspace_cache_evictions_total        — eviction counter {reason: capacity|ttl|invalidate}
#   hyperspace_cache_l1_size               — current L1 entry count (gauge)
#   hyperspace_cache_l2_index_size         — vectors in L2 HNSW graph (gauge)
#   hyperspace_cache_l2_pending_size       — vectors queued for L2 rebuild (gauge)
#   hyperspace_cache_tombstone_size        — active tombstone markers (gauge)
#   hyperspace_cache_l1_latency_seconds    — L1 lookup latency histogram
#   hyperspace_cache_l2_latency_seconds    — L2 ANN latency histogram
#   hyperspace_cache_rebuild_duration_seconds — L2 rebuild duration histogram
# ───────────────────────────────────────────────────────────────────────────


# HyperspaceDB External Plugins Catalog (`plugins/plugins.toml`)
#
# Place compiled external plugins (.dylib / .so / .dll) directly in this `./plugins`
# directory, or place standalone plugin crates in subdirectories (e.g., `./plugins/hs-git-ast/`).
#
# Plugins can be enabled or disabled at startup via `.env`:
#   HYPERSPACE_PLUGINS_DIR=./plugins
#   HYPERSPACE_ENABLED_PLUGINS=embed,shield,git_ast,eco,science,graph_onto,risk_threat,governance_ip,robotics_telemetry,cdc,multimodal
#   HYPERSPACE_DISABLED_PLUGINS=
# Or toggled dynamically at runtime via REST API:
#   POST /v1/extensions/{plugin}/enable
#   POST /v1/extensions/{plugin}/disable
#   POST /v1/extensions/reload

[plugins.git_ast]
enabled = true
library = "hs_git_ast"
crate_dir = "hs-git-ast"
description = "Instant Codebase AST Topology & Zero-Cost KAG Builder (Rust, Python, TypeScript, Go)"

[plugins.eco]
enabled = true
library = "hs_eco"
crate_dir = "hs-eco"
description = "Carbon Footprint Telemetry, RAM Quantization Efficiency Calculator & Audited SHA-256 ESG Compliance Reporter"

[plugins.science]
enabled = true
library = "hs_science"
crate_dir = "hs-science"
description = "Cheminformatics (SMILES/ECFP), Reaction Möbius Algebra, Poincaré Phylogenetics, and Waddington Stability"

[plugins.graph_onto]
enabled = true
library = "hs_graph_onto"
crate_dir = "hs-graph-onto"
description = "Hyperbolic Knowledge Graph Completion (TransE) and Ontological Subsumption"

[plugins.risk_threat]
enabled = true
library = "hs_risk_threat"
crate_dir = "hs-risk-threat"
description = "Spacetime Causal Incident Forensics, MITRE ATT&CK Light Cones, and Interbank Contagion Cascades"

[plugins.governance_ip]
enabled = true
library = "hs_governance_ip"
crate_dir = "hs-governance-ip"
description = "Legal Normative Hierarchies (Kelsen Pyramids), Patent Claim Scope, and Stare Decisis Precedent Consensus"

[plugins.robotics_telemetry]
enabled = true
library = "hs_robotics_telemetry"
crate_dir = "hs-robotics-telemetry"
description = "High-throughput Telemetry Ingestion: Foxglove MCAP, PX4 SITL (ULog), and Isaac Sim Trajectories"

[plugins.cdc]
enabled = true
library = "hs_cdc"
crate_dir = "hs-cdc"
description = "Real-time CDC Connectors: PostgreSQL Logical Replication (pgoutput/wal2json) & MySQL Binlog"

[plugins.multimodal]
enabled = true
library = "hs_multimodal"
crate_dir = "hs-multimodal"
description = "On-the-fly Sensor Audio & Video Processing: CLIP Vision Embeddings, Whisper Acoustic STT, and Hyperbolic Sensor Fusion"

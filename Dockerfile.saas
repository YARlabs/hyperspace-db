# === Stage 1: UI Builder ===
FROM node:slim AS ui-builder
WORKDIR /app/dashboard
COPY dashboard/package*.json ./
RUN npm install
COPY dashboard/ .
RUN npm run build

# === Stage 2: Rust Builder (AMD64 SaaS Optimized with External PDK Plugins) ===
FROM ubuntu:24.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    protobuf-compiler \
    cmake \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust nightly
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Remove toolchain and cargo config to avoid conflicts with build environment
COPY . .
RUN rm -f rust-toolchain.toml .cargo/config.toml

# Copy built UI assets to correct location
COPY --from=ui-builder /app/dashboard/dist ./dashboard/dist

# Build Release: s3-tiering enabled, nightly-simd for AMD64 AVX2/AVX-512
RUN cargo build --release \
    -p hyperspace-server \
    -p hyperspace-cli \
    --no-default-features --features "nightly-simd s3-tiering"

# Strip binaries to reduce size
RUN strip target/release/hyperspace-server \
    target/release/hyperspace-cli

# === Stage 3: Runtime ===
FROM ubuntu:24.04
ARG VERSION=4.2.1

# Install runtime dependencies (lightweight SaaS profile without C++ / OpenMP runtimes)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN useradd -m -u 1001 -U -s /bin/sh -d /app hyperspace

WORKDIR /app

# Copy binaries
COPY --from=builder /app/target/release/hyperspace-server /usr/local/bin/
COPY --from=builder /app/target/release/hyperspace-cli /usr/local/bin/

# Set up plugins directory and template configuration
RUN mkdir -p /app/data /app/plugins
COPY --from=builder /app/plugins/plugins.toml.example /app/plugins/plugins.toml.example
RUN cp /app/plugins/plugins.toml.example /app/plugins/plugins.toml

# Install official ECO plugin directly from Hyperspace Hub during image build
RUN hyperspace-server plugin install hs-eco --dir /app/plugins

RUN chown -R hyperspace:hyperspace /app

# Switch to non-root user
USER hyperspace

ENV RUST_LOG=info
ENV HS_DATA_DIR=/app/data
ENV HYPERSPACE_EMBED=false
ENV HYPERSPACE_PLUGINS_DIR=/app/plugins
ENV HYPERSPACE_ENABLED_PLUGINS=shield,eco

LABEL org.opencontainers.image.source=https://github.com/YARlabs/hyperspace-db
LABEL org.opencontainers.image.version="${VERSION}"
LABEL profile=saas

EXPOSE 50051
EXPOSE 50050

CMD ["hyperspace-server"]
